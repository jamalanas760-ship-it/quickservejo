# OpenAI direct server runtime for the AI menu designer.
# Keep this key server-side only; never expose it in browser/client code.
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MENU_MODEL=gpt-5.6-luna

# Managed AI gateway fallback used by the existing Lovable runtime.
# LOVABLE_API_KEY is provisioned automatically and is server-side only.

# Public callback origin used by OAuth integrations.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Figma OAuth app
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Canva Connect integration
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_BRAND_TEMPLATE_ID=

# Adobe Express Embed SDK v4
ADOBE_EXPRESS_CLIENT_ID=
ADOBE_EXPRESS_APP_NAME=QuickServe Menu Studio

# Optional Adobe Firefly / Express server APIs
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
