# OpenAI direct server runtime for the AI menu designer.
# Keep this key server-side only; never expose it in browser/client code.
OPENAI_API_KEY=
OPENAI_API_KEYS=
OPENAI_MENU_MODEL=gpt-5.6-luna

# Managed AI gateway fallback used by the existing Lovable runtime.
# LOVABLE_API_KEY is provisioned automatically and is server-side only.

# Public callback origin used by OAuth integrations.
PUBLIC_APP_URL=http://127.0.0.1:3000

# Figma OAuth app
FIGMA_CLIENT_ID=
FIGMA_CLIENT_SECRET=

# Canva Connect OAuth credentials.
# CANVA_ACCESS_TOKEN must be a user-authorized Connect API access token.
# Obtain it through Canva OAuth/PKCE; do not expose client secret or token client-side.
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
CANVA_ACCESS_TOKEN=
CANVA_BRAND_TEMPLATE_ID=

# Adobe Express Embed SDK v4 (client-side/embed integration).
ADOBE_EXPRESS_CLIENT_ID=
ADOBE_EXPRESS_APP_NAME=QuickServe Menu Studio

# Adobe Firefly / Photoshop API server-to-server credentials.
# These are separate from ADOBE_EXPRESS_CLIENT_ID and must come from an Adobe Developer Console project with the required API access.
ADOBE_CLIENT_ID=
ADOBE_CLIENT_SECRET=
