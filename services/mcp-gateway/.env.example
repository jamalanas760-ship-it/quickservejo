# Examples only. Supply real values as server-side secrets; never VITE_* variables.
MCP_PUBLIC_URL=https://mcp.example.com/mcp
MCP_OAUTH_ISSUER=https://YOUR-TENANT.auth0.com/
MCP_OAUTH_JWKS_URL=https://YOUR-TENANT.auth0.com/.well-known/jwks.json
MCP_OAUTH_AUDIENCE=https://mcp.example.com/mcp
# Operator-verified Auth0 subject -> existing QuickServe auth.users UUID.
# Never infer these bindings from email addresses or user-editable token metadata.
MCP_IDENTITY_BINDINGS={"auth0|VERIFIED-SUBJECT":"00000000-0000-4000-8000-000000000001"}
MCP_DATABASE_URL=postgresql://quickserve_mcp_gateway:REPLACE-SECURELY@DATABASE-HOST:5432/postgres
PORT=8080
